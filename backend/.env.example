# ASK Kiosk backend environment

# Postgres connection (local dev example)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/askkiosk?schema=public"

# Server
PORT=5000
NODE_ENV=development

# Secret used to hash claim codes (change in production)
CODE_SECRET="change-this-to-a-long-random-string"

# Razorpay (use TEST keys for sandbox; live keys only for real payments)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxx"
RAZORPAY_WEBHOOK_SECRET="xxxxxxxxxxxxxxxx"
